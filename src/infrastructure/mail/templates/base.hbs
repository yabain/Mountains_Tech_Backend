<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{subject}}</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background-color: #f4f6f9; font-family: 'Segoe UI', Arial, sans-serif; color: #333; }
    .wrapper { max-width: 600px; margin: 40px auto; background: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
    .header { background-color: #1a3a5c; padding: 28px 32px; text-align: center; }
    .header img { height: 48px; }
    .header h1 { color: #ffffff; font-size: 20px; margin-top: 12px; font-weight: 600; }
    .body { padding: 32px; }
    .body p { line-height: 1.7; margin-bottom: 16px; font-size: 15px; }
    .body ul { padding-left: 20px; margin-bottom: 16px; }
    .body ul li { line-height: 1.8; font-size: 15px; }
    .info-box { background: #f0f4f8; border-left: 4px solid #e07b39; padding: 16px 20px; border-radius: 4px; margin: 20px 0; }
    .info-box p { margin: 0; }
    .info-box strong { display: block; margin-bottom: 4px; color: #1a3a5c; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; }
    .btn { display: inline-block; margin: 20px 0; padding: 12px 28px; background-color: #e07b39; color: #ffffff !important; text-decoration: none; border-radius: 5px; font-size: 15px; font-weight: 600; }
    .divider { border: none; border-top: 1px solid #e8ecf0; margin: 24px 0; }
    .footer { background: #f4f6f9; padding: 20px 32px; text-align: center; font-size: 12px; color: #888; }
    .footer a { color: #e07b39; text-decoration: none; }
    .status-badge { display: inline-block; padding: 4px 12px; border-radius: 20px; font-size: 13px; font-weight: 600; }
    .status-approved { background: #d4edda; color: #155724; }
    .status-rejected { background: #f8d7da; color: #721c24; }
    .status-pending { background: #fff3cd; color: #856404; }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="header">
      <h1>Mountains Tech</h1>
    </div>
    <div class="body">
      {{{content}}}
    </div>
    <div class="footer">
      <p>© {{year}} Mountains Tech - Tous droits réservés</p>
      <p style="margin-top:6px;">
        <a href="{{siteUrl}}">Site web</a> &nbsp;|&nbsp;
        Cet email a été envoyé automatiquement, merci de ne pas y répondre.
      </p>
    </div>
  </div>
</body>
</html>
